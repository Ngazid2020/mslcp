APP_NAME=MSLCP
APP_ENV=production
APP_KEY=                        # Générer avec : php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Indian/Comoro
APP_URL=https://votre-domaine.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de données ─────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mslcp_prod
DB_USERNAME=mslcp_user
DB_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_FORT

# ── Session : Redis obligatoire en production ────────────────────────────────
# SESSION_DRIVER=database est trop lent en production.
# Installer Redis (apt install redis-server) et php-redis (pecl install redis).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.votre-domaine.com   # Préfixe . si cookie multi-sous-domaines

# ── Cache : Redis ────────────────────────────────────────────────────────────
# CACHE_STORE=database génère des requêtes parasites. Utiliser Redis.
CACHE_STORE=redis
CACHE_PREFIX=mslcp_

# ── Queue ────────────────────────────────────────────────────────────────────
# Lancer le worker : php artisan queue:work --tries=3 --sleep=3
QUEUE_CONNECTION=redis

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_REDIS
REDIS_PORT=6379

# ── Diffusion (désactivé si non utilisé) ────────────────────────────────────
BROADCAST_CONNECTION=log

# ── Stockage ─────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.votre-fournisseur.com
MAIL_PORT=587
MAIL_USERNAME=mslcp_silai@yahoo.fr
MAIL_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_MAIL
MAIL_FROM_ADDRESS=mslcp_silai@yahoo.fr
MAIL_FROM_NAME="MSLCP - Mme RAHAMATOU SILAI"

# ── Vite (production) ────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
# Lancer avant déploiement : npm run build

# ── Contact laboratoire (QR code dans les PDF) ───────────────────────────────
MSLCP_NOM_FAMILLE=SILAI
MSLCP_PRENOM=RAHAMATOU
MSLCP_TEL1=+2693330375
MSLCP_TEL2=+2694735095
MSLCP_EMAIL=mslcp_silai@yahoo.fr
MSLCP_ENTREPRISE=MSLCP
MSLCP_TITRE="Parasitologue/MSc Biochimie"

# ── Checklist de déploiement ─────────────────────────────────────────────────
# php artisan key:generate
# php artisan migrate --force
# php artisan config:cache
# php artisan route:cache
# php artisan view:cache
# php artisan storage:link
# npm run build
